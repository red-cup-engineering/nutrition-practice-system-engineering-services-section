{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:red-cup-science:nutrition:intake-event:1.0.0",
  "title":"Nutrition intake event v1","type":"object","additionalProperties":false,
  "required":["recordType","schemaVersion","eventId","affirmation","amount","foodAssertionSnapshot","mediaRetention"],
  "properties":{"recordType":{"const":"nutrition-intake-event"},"schemaVersion":{"const":"1.0.0"},"eventId":{"$ref":"#/$defs/id"},"candidateReference":{"$ref":"#/$defs/id"},"affirmation":{"type":"object","additionalProperties":false,"required":["kind","affirmedBy"],"properties":{"kind":{"const":"human-affirmed"},"affirmedBy":{"type":"string","minLength":1}}},"amount":{"$ref":"#/$defs/quantity"},"foodAssertionSnapshot":{"type":"object","additionalProperties":false,"required":["path","assertionId","source","nutrientAssertionReferences"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},"assertionId":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/source"},"nutrientAssertionReferences":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nutrientReference"}}}},"mediaRetention":{"$ref":"#/$defs/mediaRetention"}},
  "$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"source":{"type":"object","additionalProperties":false,"required":["id","release"],"properties":{"id":{"type":"string","minLength":1},"release":{"type":"string","minLength":1}}},"quantity":{"type":"object","additionalProperties":false,"required":["value","unit","basis"],"properties":{"value":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},"unit":{"type":"string","minLength":1},"basis":{"type":"string","minLength":1}}},"nutrientReference":{"type":"object","additionalProperties":false,"required":["id","nutrientId","source"],"properties":{"id":{"$ref":"#/$defs/id"},"nutrientId":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/source"}}},"mediaRetention":{"type":"object","additionalProperties":false,"required":["containsRawPhoto","containsReceiptImage","containsRawAudio","containsAppearanceEmbedding","containsRawWearablePayload"],"properties":{"containsRawPhoto":{"const":false},"containsReceiptImage":{"const":false},"containsRawAudio":{"const":false},"containsAppearanceEmbedding":{"const":false},"containsRawWearablePayload":{"const":false}}}}
}
