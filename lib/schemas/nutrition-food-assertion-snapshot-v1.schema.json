{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:red-cup-science:nutrition:food-assertion-snapshot:1.0.0",
  "title":"Nutrition food assertion snapshot v1","type":"object","additionalProperties":false,
  "required":["recordType","schemaVersion","assertionId","source","nutrientAssertions","mediaRetention"],
  "properties":{"recordType":{"const":"nutrition-food-assertion-snapshot"},"schemaVersion":{"const":"1.0.0"},"assertionId":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/source"},"nutrientAssertions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nutrientAssertion"}},"mediaRetention":{"$ref":"#/$defs/mediaRetention"}},
  "$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"source":{"type":"object","additionalProperties":false,"required":["id","release"],"properties":{"id":{"type":"string","minLength":1},"release":{"type":"string","minLength":1}}},"quantity":{"type":"object","additionalProperties":false,"required":["value","unit","basis"],"properties":{"value":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},"unit":{"type":"string","minLength":1},"basis":{"type":"string","minLength":1}}},"nutrientAssertion":{"type":"object","additionalProperties":false,"required":["id","nutrientId","quantity","source"],"properties":{"id":{"$ref":"#/$defs/id"},"nutrientId":{"type":"string","minLength":1},"quantity":{"$ref":"#/$defs/quantity"},"source":{"$ref":"#/$defs/source"}}},"mediaRetention":{"type":"object","additionalProperties":false,"required":["containsRawPhoto","containsReceiptImage","containsRawAudio","containsAppearanceEmbedding","containsRawWearablePayload"],"properties":{"containsRawPhoto":{"const":false},"containsReceiptImage":{"const":false},"containsRawAudio":{"const":false},"containsAppearanceEmbedding":{"const":false},"containsRawWearablePayload":{"const":false}}}}
}
